            ],
            "url": { "raw": "{{base_url}}/events/1/leave", "host": ["{{base_url}}"], "path": ["events","1","leave"] }
          }
        }
      ]
    },

    {
      "name": "Reference Data",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/ping", "host": ["{{base_url}}"], "path": ["ping"] }
          }
        },
        {
          "name": "Settings",
          "request": {
            "method": "GET",
            "header": [],
