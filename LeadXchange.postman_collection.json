            ],
            "url": { "raw": "{{base_url}}/languages", "host": ["{{base_url}}"], "path": ["languages"] }
          }
        },
        {
          "name": "Interests",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/interests", "host": ["{{base_url}}"], "path": ["interests"] }
          }
        }
      ]
    },

    {
      "name": "Companies",
      "item": [
        {
          "name": "Search companies",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/companies/search?q=acme",
              "host": ["{{base_url}}"],
              "path": ["companies","search"],
              "query": [{ "key": "q", "value": "acme" }]
            }
          }
        },
        {
          "name": "My company",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/companies/me", "host": ["{{base_url}}"], "path": ["companies","me"] }
          }
        },
        {
          "name": "Create / Join company",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",        "value": "application/json" },
